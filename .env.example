# Dev: development; Ubuntu/PM2 dùng production (cookie Secure cần HTTPS).
NODE_ENV="development"
TZ="Asia/Ho_Chi_Minh"

# SQLite dev; production giữ URL hiện có, ví dụ file:/srv/giaidau/data/prod.db.
DATABASE_URL="file:./dev.db"

# iron-session: chuỗi ngẫu nhiên >= 32 ký tự
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Đặt mật khẩu mạnh trước seed. Để trống: sinh ngẫu nhiên cho tài khoản mới,
# chỉ in một lần trên console; tài khoản có sẵn không bị đổi mật khẩu.
SEED_ADMIN_PASSWORD=""
SEED_ARBITER_PASSWORD=""
# Tùy chọn tạo một giải mẫu, mặc định không tạo.
SEED_DEFAULT_TOURNAMENT="false"
